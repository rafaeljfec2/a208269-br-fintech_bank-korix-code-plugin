{
  "name": "korix-code",
  "displayName": "Korix Code",
  "description": "AI-native coding runtime agentic - um assistente de código inteligente, rápido e controlável integrado ao VSCode",
  "version": "0.1.0",
  "publisher": "korix",
  "type": "module",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "code-generation",
    "refactoring",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "korix.ask",
        "title": "Korix: Ask Mode",
        "category": "Korix",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "korix.plan",
        "title": "Korix: Plan Mode",
        "category": "Korix",
        "icon": "$(list-tree)"
      },
      {
        "command": "korix.agent",
        "title": "Korix: Agent Mode",
        "category": "Korix",
        "icon": "$(robot)"
      },
      {
        "command": "korix.openSidebar",
        "title": "Korix: Open Sidebar",
        "category": "Korix",
        "icon": "$(sidebar-expand)"
      },
      {
        "command": "korix.cancelExecution",
        "title": "Korix: Cancel Execution",
        "category": "Korix",
        "icon": "$(stop)"
      },
      {
        "command": "korix.clearHistory",
        "title": "Korix: Clear History",
        "category": "Korix",
        "icon": "$(clear-all)"
      },
      {
        "command": "korix.testProvider",
        "title": "Korix: Test Provider Streaming",
        "category": "Korix",
        "icon": "$(debug-alt)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "korix-sidebar",
          "title": "Korix Code",
          "icon": "resources/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "korix-sidebar": [
        {
          "id": "korix.chatView",
          "name": "KORIX CODE",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Korix Code",
      "properties": {
        "korix.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "ollama",
            "openrouter",
            "litellm"
          ],
          "default": "anthropic",
          "description": "LLM provider to use"
        },
        "korix.anthropic.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key (stored securely in VSCode secrets)"
        },
        "korix.anthropic.model": {
          "type": "string",
          "enum": [
            "claude-opus-4-7",
            "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001"
          ],
          "default": "claude-sonnet-4-6",
          "description": "Anthropic model to use"
        },
        "korix.litellm.model": {
          "type": "string",
          "default": "anthropic/claude-opus-4-7",
          "description": "LiteLLM model to use (e.g., anthropic/claude-opus-4-7)"
        },
        "korix.litellm.baseUrl": {
          "type": "string",
          "default": "https://litellm.int.thomsonreuters.com",
          "description": "LiteLLM base URL"
        },
        "korix.openai.model": {
          "type": "string",
          "default": "gpt-4-turbo",
          "description": "OpenAI model to use"
        },
        "korix.openai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI base URL (optional, for custom endpoints)"
        },
        "korix.ollama.model": {
          "type": "string",
          "default": "llama3.2",
          "description": "Ollama model to use"
        },
        "korix.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama base URL"
        },
        "korix.openrouter.model": {
          "type": "string",
          "default": "anthropic/claude-opus-4-7",
          "description": "OpenRouter model to use"
        },
        "korix.openrouter.baseUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "OpenRouter base URL"
        },
        "korix.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens per request"
        },
        "korix.temperature": {
          "type": "number",
          "default": 0.7,
          "description": "Temperature for model responses (0-1)"
        },
        "korix.maxIterations": {
          "type": "number",
          "default": 25,
          "description": "Maximum iterations for agent loop"
        },
        "korix.contextTokenBudget": {
          "type": "number",
          "default": 180000,
          "description": "Maximum tokens for context window"
        },
        "korix.terminal.defaultTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Default timeout for terminal commands (ms)"
        },
        "korix.approvalFlow.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable approval flow for destructive actions"
        },
        "korix.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable telemetry and logging"
        }
      }
    },
    "keybindings": [
      {
        "command": "korix.ask",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "korix.agent",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "korix.cancelExecution",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "korix.isExecuting"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:css": "tailwindcss -i src/webview/main.css -o dist/webview.css --minify",
    "validate:css": "node scripts/validate-css.js",
    "compile": "npm run build:css && node esbuild.config.js --production && npm run validate:css",
    "watch": "node esbuild.config.js --watch",
    "pretest": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:litellm": "./scripts/run-test.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "clsx": "^2.1.1",
    "eventemitter3": "^5.0.1",
    "framer-motion": "^11.11.9",
    "highlight.js": "^11.11.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.0.0",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.10",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0",
    "zod": "^3.22.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.11.0",
    "@types/pino": "^7.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.22.0",
    "autoprefixer": "^10.4.14",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.31",
    "prettier": "^3.2.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/korix/korix-code"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/korix/korix-code/issues"
  },
  "homepage": "https://github.com/korix/korix-code#readme"
}
